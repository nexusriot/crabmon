# The e2e *harness*, so the suite runs on a machine that has Docker and
# nothing else.
#
# `tests/e2e/Dockerfile` has always put Rust in a container — but only to build
# crabmon. The tests driving it are an ordinary `cargo test` integration suite,
# which meant `make e2e` still needed a toolchain on the host. This image is
# the other half: a toolchain and a Docker CLI, so `cargo test --test
# e2e_docker` can run inside a container and create its sibling containers on
# the host's daemon.
#
# Both halves are pinned by digest, and the CLI is copied from the official
# image rather than installed, so this adds no apt repository and no download
# to the one thing the suite is allowed to fetch.
#
# It needs the host's Docker socket, which is root-equivalent access to that
# machine. That is the usual arrangement for a build agent, and it is why this
# is opt-in rather than what `make e2e` does when cargo is right there.

# rust:1.90-slim-bookworm
FROM rust@sha256:64232e656c058f4468e8d024e990acff04f0fd5a5c0a88a574dc37773d7325c9

# docker:27-cli — just the client; the daemon is the host's.
COPY --from=docker@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c \
     /usr/local/bin/docker /usr/local/bin/docker

# Neither is written into the mounted checkout, which stays read-only: the
# host's tree must come out of a run exactly as it went in, and a `target/`
# full of root-owned files is the usual way that promise gets broken.
ENV CARGO_HOME=/cargo \
    CARGO_TARGET_DIR=/target \
    CRABMON_E2E=1
WORKDIR /src
ENTRYPOINT ["cargo"]
CMD ["test", "--test", "e2e_docker"]
