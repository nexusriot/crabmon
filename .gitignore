# Build output
/target

# Where `make bin` and `make dist` put a release build and its tarball.
# See scripts/build.sh.
/bin/
/dist/

# Editor and OS cruft
/.vscode/
/.idea/
*.rs.bk
*.swp
.DS_Store

# Snapshots written by the `P` key. With `[export] dir` unset — the default —
# these land in the working directory, which is the checkout while developing.
# See `export::export_path`.
/crabmon-*.json
/crabmon-*.csv

# Session recordings from `--record`, and the flight recorder's dumps — with
# `[record] flight_dir` unset, those land in the working directory too, named
# by `record::dump_name`.
*.jsonl

# Action log, when `[audit] path` points somewhere relative, or when no
# platform state directory can be resolved and it falls back to `./crabmon/`.
/actions.log
/crabmon/

# `cargo vendor`, which docs/DESIGN.md names as the way to close the last
# network dependency in the e2e image build. 446 MB of dependencies is not
# something to drop into a review by accident. `.cargo/` is deliberately not
# ignored: a `config.toml` there is usually meant to be committed.
/vendor/

# Profiling output
perf.data*
flamegraph.svg
